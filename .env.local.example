# ------------------------------------------------------------------
# South Coast Cane - environment variables
# Copy this file to .env.local and fill in real values.
# The app RUNS without these (using demo data + YouTube embeds);
# fill them in to turn on real auth, data, live status, and API pulls.
# ------------------------------------------------------------------

# --- Firebase (client SDK) - safe to expose, these are public by design ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Firebase Admin (server only) - KEEP SECRET ---
# From a service account JSON key in the Firebase console.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n for newlines, wrapped in quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- YouTube Data API v3 (server only) - KEEP SECRET ---
YOUTUBE_API_KEY=

# --- Cloudflare Stream (server only) - KEEP SECRET ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Customer subdomain code for the Stream player embed (public).
NEXT_PUBLIC_CF_STREAM_CUSTOMER_CODE=

# --- Contact form email (optional) - using Resend free tier ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@southcoastcane.com

# --- Live chat (Cloudflare Durable Objects Worker) ---
# Deploy worker/ with wrangler, then paste the wss:// URL here (see worker/README.md).
NEXT_PUBLIC_CHAT_WS_URL=

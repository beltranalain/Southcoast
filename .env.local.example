# ------------------------------------------------------------------
# South Coast Cane - environment variables
# Copy this file to .env.local and fill in real values.
# The app RUNS without these (using demo data + YouTube embeds);
# fill them in to turn on real auth, data, live status, and API pulls.
# ------------------------------------------------------------------

# --- Firebase (client SDK) - safe to expose, these are public by design ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# --- Firebase Admin (server only) - KEEP SECRET ---
# From a service account JSON key in the Firebase console.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n for newlines, wrapped in quotes.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- YouTube Data API v3 (server only) - KEEP SECRET ---
YOUTUBE_API_KEY=

# --- Cloudflare Stream (server only) - KEEP SECRET ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# The Live Input UID (from the Live Input you create in the Stream dashboard).
CLOUDFLARE_STREAM_LIVE_INPUT_UID=
# Public: customer subdomain code + live input UID for the on-site player.
NEXT_PUBLIC_CF_STREAM_CUSTOMER_CODE=
NEXT_PUBLIC_CF_STREAM_LIVE_INPUT_UID=

# --- Contact form email (optional) - using Resend free tier ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@southcoastcane.com

# --- Live chat + studio signaling (Cloudflare Durable Objects Worker) ---
# Deploy worker/ with wrangler, then paste the wss:// URL here (see worker/README.md).
NEXT_PUBLIC_CHAT_WS_URL=

# --- Cloudflare Realtime (browser guest studio) - SECRET ---
# Create a Realtime app in the Cloudflare dashboard (Realtime -> Serverless SFU).
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_TOKEN=

# --- Chat/tip relay auth (shared secret between app and the Worker) ---
# Any random string; must match the value configured on the Worker.
CHAT_ADMIN_SECRET=

# --- Stripe (viewer tipping) - SECRET ---
# Sandbox/test keys work fine. Only the SECRET key is needed (hosted Checkout).
# STRIPE_WEBHOOK_SECRET turns on the on-air tip alert + highlighted chat +
# recording in /admin/tips (get it from `stripe listen` locally, or from the
# webhook endpoint you create in the Stripe Dashboard for the deployed site).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
